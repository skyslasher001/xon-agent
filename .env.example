# Kestrel Configuration
# Copy to .env and fill in required values

# =============================================================================
# RPC Endpoints (at least one required)
# =============================================================================
# Yellowstone gRPC (primary ingestion)
YELLOWSTONE_GRPC_URL=http://localhost:10000
YELLOWSTONE_GRPC_TOKEN=

# WebSocket fallback
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# HTTP RPC for queries
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# =============================================================================
# Wallet (BIP39 mnemonic - NEVER commit real keys)
# =============================================================================
WALLET_MNEMONIC=abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about

# =============================================================================
# OKX Integration
# =============================================================================
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_DEX_API_KEY=
OKX_DEX_API_SECRET=

# =============================================================================
# Jito
# =============================================================================
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_AUTH_KEY=

# =============================================================================
# Notifications
# =============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# =============================================================================
# Database
# =============================================================================
DATABASE_URL=postgresql://kestrel:kestrel@localhost:5432/kestrel
PARQUET_DATA_DIR=./data/parquet

# =============================================================================
# Trading Mode
# =============================================================================
# paper, backtest, live (live requires KESTREL_LIVE_CONFIRM)
TRADING_MODE=paper

# Live trading confirmation (double-lock)
KESTREL_LIVE_CONFIRM=
LIVE_EXECUTOR_AVAILABLE=false

# =============================================================================
# Risk Parameters (override defaults)
# =============================================================================
# Max position size in SOL (default: 2)
MAX_POSITION_SOL=2
# Max total exposure in SOL (default: 20)
MAX_EXPOSURE_SOL=20
# Max daily loss in SOL (default: 5)
MAX_DAILY_LOSS_SOL=5

# =============================================================================
# Logging
# =============================================================================
RUST_LOG=kestrel=info,tower=warn,hyper=warn
RUST_LOG_STYLE=auto